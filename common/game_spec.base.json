{
  "meta": {
    "id": "template-zero",
    "title": "Template Zero",
    "version": "0.1.0",
    "archetype": "base",
    "scoreLabel": "Score"
  },
  "display": {
    "stage": { "width": 720, "height": 1280 },
    "fit": "contain",
    "maxDpr": 2,
    "safeMargin": 24,
    "targetFps": 60
  },
  "style": {
    "palette": {
      "bg": "#121318",
      "surface": "#1E2028",
      "line": "#343846",
      "text": "#F4F5F7",
      "textMuted": "#9BA1AE",
      "player": "#4CC9F0",
      "hazard": "#F25F5C",
      "pickup": "#FFD166",
      "positive": "#06D6A0",
      "special": "#B388FF",
      "neutral": "#7D8597"
    },
    "fontFamily": "system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "fontSizes": { "title": 88, "heading": 56, "hudScore": 56, "hudSecondary": 32, "body": 32, "button": 40, "hint": 28 },
    "stroke": 4,
    "radius": 16,
    "ui": { "buttonRadius": 24, "minTouch": 88, "buttonMinWidth": 240, "dimAlpha": 0.6, "panelAlpha": 0.92 },
    "feedback": {
      "flashDuration": 0.08,
      "popupRise": 60,
      "popupDuration": 0.6,
      "shakeEnabled": true,
      "shakeAmplitude": 8,
      "shakeDuration": 0.15,
      "squash": 0.15,
      "squashDuration": 0.1,
      "particlesPerBurst": 8,
      "particleLife": 0.4,
      "fadeDuration": 0.2
    }
  },
  "audio": {
    "masterVolume": 0.7,
    "maxVoices": 8,
    "sfx": {
      "uiTap": { "wave": "square", "freq": 660, "duration": 0.05, "volume": 0.25 },
      "start": { "wave": "triangle", "freq": 440, "freqEnd": 880, "duration": 0.15, "volume": 0.4 },
      "collect": { "wave": "sine", "freq": 880, "freqEnd": 1320, "duration": 0.08, "volume": 0.4 },
      "hit": { "wave": "noise", "freq": 0, "duration": 0.12, "volume": 0.5 },
      "destroy": { "wave": "square", "freq": 220, "freqEnd": 110, "duration": 0.1, "volume": 0.35 },
      "action": { "wave": "triangle", "freq": 520, "freqEnd": 700, "duration": 0.06, "volume": 0.35 },
      "powerup": { "wave": "sine", "freq": 523, "freqEnd": 1046, "duration": 0.25, "volume": 0.4 },
      "win": { "wave": "triangle", "freq": 523, "freqEnd": 1046, "duration": 0.4, "volume": 0.45 },
      "lose": { "wave": "sawtooth", "freq": 330, "freqEnd": 110, "duration": 0.5, "volume": 0.35 }
    }
  },
  "text": {
    "tapToStart": "Tap or press Space to start",
    "best": "Best",
    "newBest": "New best!",
    "paused": "Paused",
    "resume": "Resume",
    "quit": "Quit",
    "playAgain": "Play again",
    "menu": "Menu",
    "win": "You win!",
    "lose": "Game over",
    "loading": "Loading",
    "controlsKeyboard": "Space: action",
    "controlsTouch": "Tap: action"
  },
  "input": {
    "bufferTime": 0.1,
    "gestures": {
      "tapMaxDuration": 0.25,
      "tapMaxMove": 24,
      "swipeMinDistance": 60,
      "swipeMaxDuration": 0.35,
      "joystickRadius": 90
    },
    "bindings": {
      "confirm": { "keys": ["Enter", "Space"], "pointer": "tap" },
      "pause": { "keys": ["Escape", "KeyP"], "pointer": "pauseButton" }
    }
  },
  "rules": {
    "resultInputDelay": 0.6
  },
  "limits": {
    "particles": 64,
    "popups": 16,
    "collisionCell": 128
  },
  "debug": {
    "showFps": false,
    "showHitboxes": false,
    "invincible": false,
    "timeScale": 1
  }
}
