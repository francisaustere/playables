{
  "meta": {
    "id": "platformer",
    "title": "Platformer",
    "version": "0.1.0",
    "archetype": "platformer",
    "scoreLabel": "Score"
  },
  "display": {
    "fit": "expand"
  },
  "text": {
    "controlsKeyboard": "Left/Right or A/D: run - Space/Up/W: jump (twice for double jump)",
    "controlsTouch": "Left/right buttons: run - Jump button: jump (twice for double jump)",
    "lose": "Game over",
    "win": "All levels cleared!",
    "levelClear": "Level clear!",
    "level": "Level",
    "next": "Next level"
  },
  "input": {
    "touchButtons": {
      "size": 128,
      "gap": 24,
      "alpha": 0.45,
      "showOnlyAfterTouch": true
    },
    "bindings": {
      "left": {
        "keys": [
          "ArrowLeft",
          "KeyA"
        ],
        "pointer": "button:left"
      },
      "right": {
        "keys": [
          "ArrowRight",
          "KeyD"
        ],
        "pointer": "button:right"
      },
      "jump": {
        "keys": [
          "Space",
          "ArrowUp",
          "KeyW"
        ],
        "pointer": "button:jump"
      }
    }
  },
  "rules": {
    "lives": 3,
