{
  "meta": {
    "id": "tap-clicker",
    "title": "Tap & Choose",
    "version": "0.1.0",
    "archetype": "tap-clicker",
    "scoreLabel": "Coins earned"
  },
  "display": {
    "stage": {
      "width": 720,
      "height": 1280
    },
    "fit": "contain",
    "maxDpr": 2,
    "safeMargin": 24,
    "targetFps": 60
  },
  "style": {
    "palette": {
      "bg": "#121318",
      "surface": "#1E2028",
      "line": "#343846",
      "text": "#F4F5F7",
      "textMuted": "#9BA1AE",
      "player": "#4CC9F0",
      "hazard": "#F25F5C",
      "pickup": "#FFD166",
      "positive": "#06D6A0",
      "special": "#B388FF",
      "neutral": "#7D8597"
    },
    "fontFamily": "system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "fontSizes": {
      "title": 88,
      "heading": 56,
      "hudScore": 56,
      "hudSecondary": 32,
      "body": 32,
      "button": 40,
      "hint": 28
    },
    "stroke": 4,
    "radius": 16,
    "ui": {
      "buttonRadius": 24,
      "minTouch": 88,
      "buttonMinWidth": 240,
      "dimAlpha": 0.6,
      "panelAlpha": 0.92
    },
    "feedback": {
      "flashDuration": 0.08,
      "popupRise": 60,
      "popupDuration": 0.6,
      "shakeEnabled": true,
      "shakeAmplitude": 8,
      "shakeDuration": 0.15,
      "squash": 0.15,
      "squashDuration": 0.1,
      "particlesPerBurst": 8,
      "particleLife": 0.4,
      "fadeDuration": 0.2
    }
  },
  "audio": {
    "masterVolume": 0.7,
    "maxVoices": 8,
    "sfx": {
      "uiTap": {
        "wave": "square",
        "freq": 660,
        "duration": 0.05,
        "volume": 0.25
      },
      "start": {
        "wave": "triangle",
        "freq": 440,
        "freqEnd": 880,
        "duration": 0.15,
        "volume": 0.4
      },
      "collect": {
        "wave": "sine",
        "freq": 880,
        "freqEnd": 1320,
        "duration": 0.08,
        "volume": 0.4
      },
      "hit": {
        "wave": "noise",
        "freq": 0,
        "duration": 0.12,
        "volume": 0.5
      },
      "destroy": {
        "wave": "square",
        "freq": 220,
        "freqEnd": 110,
        "duration": 0.1,
        "volume": 0.35
      },
      "action": {
        "wave": "triangle",
        "freq": 520,
        "freqEnd": 700,
        "duration": 0.06,
        "volume": 0.35
      },
      "powerup": {
        "wave": "sine",
        "freq": 523,
        "freqEnd": 1046,
        "duration": 0.25,
        "volume": 0.4
      },
      "win": {
        "wave": "triangle",
        "freq": 523,
        "freqEnd": 1046,
        "duration": 0.4,
        "volume": 0.45
      },
      "lose": {
        "wave": "sawtooth",
        "freq": 330,
        "freqEnd": 110,
        "duration": 0.5,
        "volume": 0.35
      },
      "tap": {
        "wave": "triangle",
        "freq": 520,
        "freqEnd": 620,
        "duration": 0.04,
        "volume": 0.25
      },
      "buy": {
        "wave": "square",
        "freq": 440,
        "freqEnd": 880,
        "duration": 0.12,
        "volume": 0.3
      },
      "denied": {
        "wave": "square",
        "freq": 180,
        "freqEnd": 150,
        "duration": 0.1,
        "volume": 0.25
      },
      "choice": {
        "wave": "sine",
        "freq": 600,
        "freqEnd": 900,
        "duration": 0.2,
        "volume": 0.35
      },
      "boostEnd": {
        "wave": "sine",
        "freq": 700,
        "freqEnd": 350,
        "duration": 0.2,
        "volume": 0.25
      }
    }
  },
  "text": {
    "tapToStart": "Tap or press Space to start",
    "best": "Best",
    "newBest": "New best!",
    "paused": "Paused",
    "resume": "Resume",
    "quit": "Quit",
    "playAgain": "Play again",
    "menu": "Menu",
    "win": "Goal reached!",
    "lose": "Time's up",
    "loading": "Loading",
    "controlsKeyboard": "Space: tap - 1-4: buy - 1/2: choose",
    "controlsTouch": "Tap the core - Tap an upgrade to buy",
    "currency": "coins",
    "perSecond": "/s",
    "goal": "Goal",
    "level": "Lv",
    "max": "MAX",
    "choiceTitle": "Choose one",
    "suffixes": [
      "",
      "K",
      "M",
      "B",
      "T"
    ]
  },
  "input": {
    "bufferTime": 0.1,
    "gestures": {
      "tapMaxDuration": 0.25,
      "tapMaxMove": 24,
      "swipeMinDistance": 60,
      "swipeMaxDuration": 0.35,
      "joystickRadius": 90
    },
    "bindings": {
      "confirm": {
        "keys": [
          "Enter",
          "Space"
        ],
        "pointer": "tap"
      },
      "pause": {
        "keys": [
          "Escape",
          "KeyP"
        ],
        "pointer": "pauseButton"
      },
      "tap": {
        "keys": [
          "Space"
        ],
        "pointer": "tapCore"
      },
      "buy1": {
        "keys": [
          "Digit1",
          "Numpad1"
        ],
        "pointer": "upgradeButton"
      },
      "buy2": {
        "keys": [
          "Digit2",
          "Numpad2"
        ],
        "pointer": "upgradeButton"
      },
      "buy3": {
        "keys": [
          "Digit3",
          "Numpad3"
        ],
        "pointer": "upgradeButton"
      },
      "buy4": {
        "keys": [
          "Digit4",
          "Numpad4"
        ],
        "pointer": "upgradeButton"
      },
      "choose1": {
        "keys": [
          "Digit1",
          "Numpad1",
          "ArrowLeft"
        ],
        "pointer": "choiceButton"
      },
      "choose2": {
        "keys": [
          "Digit2",
          "Numpad2",
          "ArrowRight"
        ],
        "pointer": "choiceButton"
      }
    }
  },
  "rules": {
    "resultInputDelay": 0.6,
    "targetCoins": 100000,
    "timeLimit": 240,
    "timeBonusPerSecond": 500,
    "maxTapsPerSecond": 20,
    "passivePopupInterval": 1,
    "choiceTimeout": 8
  },
  "limits": {
    "particles": 64,
    "popups": 32,
    "collisionCell": 128,
    "boosts": 4
  },
  "debug": {
    "showFps": false,
    "showHitboxes": false,
    "invincible": false,
    "timeScale": 1
  },
  "economy": {
    "startCoins": 0,
    "tapValue": 1,
    "upgrades": [
      {
        "id": "strongTap",
        "name": "Strong tap",
        "baseCost": 15,
        "costGrowth": 1.15,
        "maxLevel": 50,
        "effect": {
          "tapAdd": 1
        },
        "look": {
          "shape": "circle",
          "color": "player",
          "size": 40
        }
      },
      {
        "id": "helper",
        "name": "Helper",
        "baseCost": 50,
        "costGrowth": 1.15,
        "maxLevel": 50,
        "effect": {
          "perSecond": 2
        },
        "look": {
          "shape": "diamond",
          "color": "pickup",
          "size": 40
        }
      },
      {
        "id": "factory",
        "name": "Factory",
        "baseCost": 600,
        "costGrowth": 1.15,
        "maxLevel": 50,
        "effect": {
          "perSecond": 25
        },
        "look": {
          "shape": "rect",
          "color": "neutral",
          "size": 40
        }
      },
      {
        "id": "booster",
        "name": "Booster x2",
        "baseCost": 2000,
        "costGrowth": 4,
        "maxLevel": 4,
        "effect": {
          "multiply": 2
        },
        "look": {
          "shape": "hexagon",
          "color": "special",
          "size": 40
        }
      }
    ]
  },
  "entities": [
    {
      "id": "core",
      "kind": "core",
      "x": 360,
      "y": 560,
      "tapSquash": 0.12,
      "popupSpread": 50,
      "look": {
        "shape": "circle",
        "color": "player",
        "size": 260
      }
    }
  ],
  "levels": {
    "choices": [
      {
        "id": "safeOrBold",
        "prompt": "A crate appears",
        "options": [
          {
            "label": "+15% coins now",
            "effects": [
              {
                "type": "addCoinsRatio",
                "value": 0.15
              }
            ]
          },
          {
            "label": "50%: double, 50%: lose half",
            "effects": [
              {
                "type": "gamble",
                "chance": 0.5,
                "winRatio": 1,
                "loseRatio": -0.5
              }
            ]
          }
        ]
      },
      {
        "id": "tapOrIdle",
        "prompt": "Power surge",
        "options": [
          {
            "label": "Taps x5 for 15 s",
            "effects": [
              {
                "type": "boost",
                "target": "tap",
                "multiply": 5,
                "duration": 15
              }
            ]
          },
          {
            "label": "Income x3 for 15 s",
            "effects": [
              {
                "type": "boost",
                "target": "passive",
                "multiply": 3,
                "duration": 15
              }
            ]
          }
        ]
      },
      {
        "id": "saleOrCash",
        "prompt": "Market day",
        "options": [
          {
            "label": "Upgrades -50% for 20 s",
            "effects": [
              {
                "type": "discount",
                "value": 0.5,
                "duration": 20
              }
            ]
          },
          {
            "label": "+60 s of income now",
            "effects": [
              {
                "type": "addIncomeSeconds",
                "value": 60
              }
            ]
          }
        ]
      },
      {
        "id": "quizShape",
        "prompt": "Quiz: which shape has 6 sides?",
        "options": [
          {
            "label": "Hexagon",
            "effects": [
              {
                "type": "addIncomeSeconds",
                "value": 30
              }
            ]
          },
          {
            "label": "Pentagon",
            "effects": [
              {
                "type": "boost",
                "target": "all",
                "multiply": 0.5,
                "duration": 10
              }
            ]
          }
        ]
      }
    ]
  },
  "difficulty": {
    "choiceInterval": [
      {
        "at": 0,
        "value": 30
      },
      {
        "at": 180,
        "value": 20
      }
    ]
  }
}
