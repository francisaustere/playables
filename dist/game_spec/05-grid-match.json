        "points": 60
      },
      {
        "id": "line3",
        "shape": "line",
        "size": 3,
        "bonus": "",
        "points": 0
      }
    ]
  },
  "limits": {
    "particles": 96,
    "popups": 16,
    "collisionCell": 128,
    "tiles": 81
  },
  "debug": {
    "showFps": false,
    "showHitboxes": false,
    "invincible": false,
    "timeScale": 1
  },
  "board": {
    "maxWidth": 660,
    "maxHeight": 820,
