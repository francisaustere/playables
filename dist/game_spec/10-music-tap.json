      "pause": {
        "keys": [
          "Escape",
          "KeyP"
        ],
        "pointer": "pauseButton"
      },
      "lane0": {
        "keys": [
          "KeyD",
          "ArrowLeft"
        ],
        "pointer": "laneZone0"
      },
      "lane1": {
        "keys": [
          "KeyF",
          "ArrowDown"
        ],
        "pointer": "laneZone1"
      },
      "lane2": {
        "keys": [
          "KeyJ",
          "ArrowUp"
        ],
        "pointer": "laneZone2"
