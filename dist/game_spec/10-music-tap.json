  "style": {
    "palette": {
      "bg": "#121318",
      "surface": "#1E2028",
      "line": "#343846",
      "text": "#F4F5F7",
      "textMuted": "#9BA1AE",
      "player": "#4CC9F0",
      "hazard": "#F25F5C",
      "pickup": "#FFD166",
      "positive": "#06D6A0",
      "special": "#B388FF",
      "neutral": "#7D8597"
